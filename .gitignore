# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle Wrapper binaries are required for reproducible builds.
!gradle/wrapper/gradle-wrapper.jar
!upstream/create-mc1.20.1-6.0.8/gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Gradle 自动化构建工具产生的缓存和运行目录
/.gradle/
/build/
/run/
/out/

# Forge 1.7.10 特有的反编译和设置目录
/eclipse/
/.mcp/
/forge/

# 开发工具（IDE）配置文件
/.idea/
/.vscode/
/*.iml
/*.ipr
/*.iws
/.classpath
/.project
/.settings/

# 操作系统临时文件
Thumbs.db
.DS_Store

# Kotlin 构建缓存 (Kotlin 2.0+)
/.kotlin/

# Minecraft 运行日志目录 (含 .log.gz 等)
/logs/

# 临时文件
*.tmp
*.bak
*.swp
/tmp/
/bin/

# Historical prototypes are archived outside the Git repository.
/prototype/

# Gradle 本地配置
/local.properties

# Eclipse 启动配置
/*.launch

# Local Configs for Claude
/.claude/

# Local coding-agent and editor caches.
/.agents/
/.codex/
/.cache/
/.factorypath
/.gradletasknamecache

# Local secrets and machine-specific environment files.
/.env
/.env.*
!/.env.example

# Minecraft development runtime output outside the configured run directory.
/crash-reports/
/screenshots/
/saves/
/resourcepacks/
/shaderpacks/
/mods/
/config/

# Profiling and JVM diagnostic output.
*.hprof
*.jfr
